        {
          "_name": "content8",
          "_sourceTheme": "mobirise5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".counter-container": {
              "ul": {
                "margin": "0",
                "list-style": "none",
                "padding-left": "2.5rem",
                "li": {
                  "margin-bottom": "1rem",
                  "position": "relative",
                  "& when (@stylizedCounters)": {
                    "list-style": "none",
                    "position": "relative",
                    "padding-left": "1rem",
                    "&:before": {
                      "position": "absolute",
                      "left": "-40px",
                      "content": "\"\"",
                      "display": "flex",
                      "justify-content": "center",
                      "align-items": "center",
                      "color": "contrast(@iconColor)",
                      "background-color": "@iconColor",
                      "width": "40px",
                      "height": "40px",
                      "border-radius": "50%",
                      "margin-top": "5px",
                      "& when (@countersType = \"circle\")": {
                        "background": "none",
                        "border": "1px solid @iconColor",
                        "color": "@iconColor"
                      },
                      "& when (@countersType = \"square\")": {
                        "border-radius": "0"
                      },
                      "& when (@mark)": {
                        "content": "\"✓\""
                      }
                    }
                  },
                  "& when not (@stylizedCounters)": {
                    "&:before": {
                      "position": "absolute",
                      "left": "-1.6rem",
                      "content": "\"\\2022\"",
                      "color": "@iconColor",
                      "font-weight": "bold",
                      "font-size": "2rem",
                      "width": "1.6rem",
                      "line-height": "1.2"
                    }
                  }
                }
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content8\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"11\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Stylized\" name=\"stylizedCounters\" checked>\n        <input type=\"checkbox\" title=\"Mark\" name=\"mark\" checked condition=\"stylizedCounters\">\n        <select title=\"Type\" name=\"countersType\" condition=\"stylizedCounters\">\n            <option value=\"default\" selected>Сircle Fill</option>\n            <option value=\"circle\">Circle</option>\n            <option value=\"square\">Square</option>\n        </select>\n        <input type=\"color\" name=\"iconColor\" title=\"Color\" value=\"#000000\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#f7f7f7\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"counter-container col-md-12 col-lg-{{textWidth}}\">\n                <h4 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\"><div><b>Emperor’s Vigor Tonic</b> is a dietary supplement formulated with a blend of 11 botanical ingredients traditionally used in herbal wellness practices. The formula is marketed to support men’s daily vitality, energy, stamina, and overall well-being.</div><br><div><b>Here are the ingredients listed in the product’s published formula:</b></div></h4>\n                <div class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article>\n                    <ul>\n                        <li><span style=\"font-size: 20.8px;\"><b>Dodder Seed – </b>Traditionally used in herbal preparations associated with vitality and reproductive wellness.</span></li><li><span style=\"font-size: 20.8px;\"><b>Wild Yam – </b>A botanical root traditionally used in various herbal wellness formulations.</span></li><li><span style=\"font-size: 20.8px;\"><b>Rehmanniae Radix – </b>A root used in traditional Chinese herbal practices</span></li><li><span style=\"font-size: 20.8px;\"><b>Cnidium Monnieri – </b>A plant traditionally included in herbal preparations for men’s wellness.</span></li><li><span style=\"font-size: 20.8px;\"><b>Eucommia Ulmoides – </b>A tree bark used in traditional herbal practices for general wellness.</span></li><li><span style=\"font-size: 20.8px;\"><b>Cistanche – </b>A traditional botanical associated with vitality and stamina in herbal medicine.</span></li></ul><ul><li><span style=\"font-size: 20.8px;\"><b>Radix Achyranthis – </b>A plant root used in traditional Chinese herbal formulations.</span></li><li><span style=\"font-size: 20.8px;\"><b>Schisandra – </b>A berry traditionally used in herbal preparations for resilience and general wellness.</span></li><li><span style=\"font-size: 20.8px;\"><b>Poria Cocos –</b> A fungus commonly used in traditional Chinese herbal medicine.</span></li><li><span style=\"font-size: 20.8px;\"><b>Shan Zhu Yu –</b> Also known as Cornus officinalis, a fruit used in traditional herbal formulations.</span></li><li><span style=\"font-size: 20.8px;\"><b>Polygala Tenuifolia –</b> A root traditionally used in Chinese herbal practices.</span></li></ul>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
